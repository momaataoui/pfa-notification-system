# Copier ce fichier en .env (jamais commite) et renseigner les vraies valeurs.

# Canal Email — compte Gmail + mot de passe d'application
# https://myaccount.google.com/apppasswords
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# Canal SMS — compte Vonage (essai gratuit possible)
# https://developer.vonage.com/
VONAGE_API_KEY=
VONAGE_API_SECRET=
